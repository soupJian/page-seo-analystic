{
  "manifest_version": 3,
  "name": "Page Analytics - SEO分析工具",
  "version": "1.0.0",
  "description": "分析网页SEO信息，提供优化建议",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "action": {
    "default_title": "Page Analytics"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "sidebar.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html",
        "sidebar.css",
        "sidebar.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}